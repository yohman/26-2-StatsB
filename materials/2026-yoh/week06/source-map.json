    "individualZ": {
      "tex": "Z=\\frac{X-E(X)}{\\sqrt{\\operatorname{Var}(X)}}=\\frac{X-\\mu}{\\sigma}",
      "page": "123（標準化を1個の値Xに適用・前回の復習）",
      "highlightTex": "Z=\\frac{X-E(X)}{\\sqrt{\\operatorname{Var}(X)}}=\\frac{\\textcolor{#B65C16}{X}-\\mu}{\\textcolor{#13768C}{\\sigma}}"
    },
    "mean": {
      "tex": "\\bar{x}=\\frac{1}{n}(x_1+x_2+\\cdots+x_n)",
      "page": "122（脚注2）"
    },
    "z": {
      "tex": "Z=\\frac{\\bar X-E(\\bar X)}{\\sqrt{Var(\\bar X)}}=\\frac{\\bar X-\\mu_x}{\\sqrt{\\frac{\\sigma_x^2}{n}}}",
      "page": "123（上段）",
      "highlightTex": "Z=\\frac{\\bar X-E(\\bar X)}{\\sqrt{Var(\\bar X)}}=\\frac{\\textcolor{#FFB45B}{\\bar X}-\\mu_x}{\\textcolor{#72D6EA}{\\sqrt{\\frac{\\sigma_x^2}{n}}}}"
    },
    "zWords": {
      "tex": "Z=\\frac{\\bar X-\\mu_x}{\\sqrt{\\frac{\\sigma_x^2}{n}}}=\\frac{\\text{標本平均}-\\text{母平均}}{\\sqrt{\\frac{\\text{母分散}}{\\text{標本数}}}}",
      "page": "123（上段）"
    },
    "t": {
      "tex": "T=\\frac{\\bar X-\\mu_x}{\\sqrt{\\frac{\\widehat{\\sigma_x^2}}{n}}}",
      "page": "125（下段）"
    },
    "uv": {
      "tex": "\\widehat{\\sigma_x^2}=\\frac{1}{n-1}\\sum(X_i-\\bar X)^2",
      "page": "126（上段）"
    },
    "central": {
      "tex": "\\Pr(-t_{\\alpha}(\\nu)<T<t_{\\alpha}(\\nu))=0.90",
      "page": "127（例②）"
    },
    "u": {
      "tex": "U_0=\\frac{\\sum_{i=1}^{n}(x_i-\\mu_x)^2}{\\sigma_x^2}",
      "page": "128（平方和の分解・左辺）"
    },
    "decomposition": {
      "tex": "U_0=\\frac{\\sum_{i=1}^{n}(x_i-\\mu_x)^2}{\\sigma_x^2}=\\frac{\\sum_{i=1}^{n}(x_i-\\bar X)^2}{\\sigma_x^2}+\\frac{n(\\bar X-\\mu_x)^2}{\\sigma_x^2}",
      "page": "128（平方和の分解）"
    },
    "chi": {
      "tex": "U\\sim\\chi^2(\\nu)",
      "page": "128（冒頭）"
    }
